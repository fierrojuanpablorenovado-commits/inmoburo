{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "includeFiles": "api-src/**" } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/public/upload/(.*)", "dest": "/public/public-upload.html" },
    { "src": "/app(/.*)?", "dest": "/public/app.html" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.+)", "dest": "/public/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/recordatorio-documentos",
      "schedule": "0 10 * * *"
    }
  ]
}
