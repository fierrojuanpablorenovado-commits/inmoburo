# InmoBuró — Variables de entorno
# Copia este archivo a .env.local (dev) o configura en Vercel (prod)

# Postgres connection string (Neon, Supabase o Vercel Postgres)
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/inmoburo?sslmode=require"

# Secreto para firmar JWTs (genera uno con: openssl rand -hex 32)
JWT_SECRET="cambia-esto-por-uno-fuerte-de-64-caracteres-minimo"

# Puerto local (en Vercel se ignora)
PORT=4180
