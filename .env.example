# Solventa — Variables de entorno
# Copia este archivo a .env.local (dev) o configura en Vercel (prod)

# ─── Base de datos ────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase o Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/solventaburo?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secreto para firmar JWTs (genera uno con: openssl rand -hex 32)
JWT_SECRET="cambia-esto-por-uno-fuerte-de-64-caracteres-minimo"

# ─── Stripe (pagos) ───────────────────────────────────────────────────────────
# Sin estas vars → modo mock (el sistema funciona igual, solo loguea)
# Obtén tus keys en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Webhook secret desde: https://dashboard.stripe.com/webhooks → endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Resend (email transaccional) ─────────────────────────────────────────────
# Sin estas vars → modo mock (loguea emails en consola)
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Dominio verificado en Resend. Sin dominio propio usa: "Solventa Buró <onboarding@resend.dev>"
FROM_EMAIL="Solventa Buró <hola@solventaburo.com>"

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Sin estas vars → modo mock (loguea mensajes en consola)
# Obtén en: https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_TOKEN="EAAxxxxx..."
WHATSAPP_PHONE_ID="1234567890"

# ─── Nubarium (verificación identidad + IMSS + listas negras MX) ──────────────
# Sin esta var → modo mock (funciona igual, datos simulados)
# Obtén tu key en: https://nubarium.com — paquete API + API+
NUBARIUM_API_KEY="nb_live_..."

# ─── Local dev ────────────────────────────────────────────────────────────────
PORT=4180
NODE_ENV=development
